# Secrets for the Docker stack. Copy to docker/.env and fill in. Never commit.

# LLM provider for engram's own synthesis (digest/research playbooks).
# Any OpenAI-compatible endpoint: OpenAI, a local server (LM Studio, vLLM,
# Ollama), a gateway (OpenRouter), or Anthropic's OpenAI-compatible /v1.
# Leave blank to use structural (non-LLM) synthesis.
ENGRAM_LLM_BASE_URL=
ENGRAM_LLM_API_KEY=
ENGRAM_LLM_MODEL=

# Optional: vault bind-mount host path (default ./vault next to compose.yml).
# ENGRAM_VAULT=~/engram-vault

# Optional: digest cadence in seconds (default 86400 = daily).
# ENGRAM_DIGEST_INTERVAL=86400

# Optional: source adapter tokens (e.g. GitHub for the github-repo adapter).
# GITHUB_TOKEN=
