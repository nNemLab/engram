# Secrets. Copy to ~/.engram/.env and fill in. Never commit.

# LLM provider for engram's own synthesis (digest/research playbooks).
# Any OpenAI-compatible endpoint: OpenAI, a local server (LM Studio, vLLM,
# Ollama), a gateway (OpenRouter), or any vendor's OpenAI-compatible /v1.
ENGRAM_LLM_BASE_URL=
ENGRAM_LLM_API_KEY=
ENGRAM_LLM_MODEL=

# Optional: override config location
# ENGRAM_CONFIG=~/.engram/config.yml
