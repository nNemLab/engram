{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "engram",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "toml", "path": "uv.lock", "jsonpath": "$.package[?(@.name=='engram')].version" },
        { "type": "generic", "path": "src/engram/__init__.py" },
        { "type": "json", "path": "engram-plugin/.claude-plugin/plugin.json", "jsonpath": "$.version" }
      ]
    }
  }
}
