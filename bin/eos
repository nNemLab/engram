#!/usr/bin/env bash
# Top-level dispatcher. `aos <subcommand>` routes to bin/aos-<subcommand>.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"

if [[ $# -lt 1 ]]; then
    cat <<EOF
aos — Engram control surface

usage: aos <command> [args]

commands:
  init        First-time setup (db, vault, config)
  mcp         Run the MCP server (stdio; meant for Claude Code to launch)
  projector   Run the vault projection daemon
  watcher     Run the vault watcher daemon
  reactor     Run the event reactor
  status      Show daemon health and counts
  query       RAG query (alias for: engram-rag query)
EOF
    exit 1
fi

cmd="$1"; shift
target="$here/aos-$cmd"
if [[ ! -x "$target" ]]; then
    echo "unknown command: $cmd" >&2
    exit 2
fi
exec "$target" "$@"
