#!/usr/bin/env bash
# First-time setup. Creates ~/.engram, builds the runtime venv and installs
# engram into it, copies config + .env, scaffolds the vault, initializes the DB.
# Requires uv (https://docs.astral.sh/uv/) and Python 3.11+.
set -euo pipefail

src="$(cd "$(dirname "$0")/.." && pwd)"
root="${ENGRAM_ROOT:-$HOME/.engram}"
venv="${ENGRAM_VENV:-$root/.venv}"

if ! command -v uv >/dev/null 2>&1; then
    echo "error: 'uv' not found on PATH. Install it from https://docs.astral.sh/uv/ and re-run." >&2
    exit 1
fi

echo "==> Engram init at $root"
mkdir -p "$root" "$root/playbooks/scratch" "$root/playbooks/curated" "$root/playbooks/runs"

# Config
if [[ ! -f "$root/config.yml" ]]; then
    cp "$src/config.example.yml" "$root/config.yml"
    echo "  + $root/config.yml (copied from config.example.yml)"
else
    echo "  = $root/config.yml (kept existing)"
fi

# Env
if [[ ! -f "$root/.env" ]]; then
    cp "$src/.env.example" "$root/.env"
    echo "  + $root/.env (copied; fill in keys)"
else
    echo "  = $root/.env (kept existing)"
fi

# Vault scaffold
if [[ ! -d "$root/vault" ]]; then
    cp -r "$src/vault-template" "$root/vault"
    # Drop .gitkeep stubs.
    find "$root/vault" -name '.gitkeep' -delete
    echo "  + $root/vault (scaffolded from vault-template)"
else
    echo "  = $root/vault (kept existing)"
fi

# Runtime venv. The systemd units and bin/ wrappers run from here, so engram
# must be installed into it (not just the caller's active environment).
echo "==> Creating venv at $venv and installing engram (editable)"
if [[ ! -d "$venv" ]]; then
    uv venv "$venv"
    echo "  + $venv"
else
    echo "  = $venv (kept existing)"
fi
# Install with the [rag] extra so embeddings/rerank (sentence-transformers +
# torch) are present — the reactor needs them. Core stays torch-free for CI.
uv pip install --python "$venv/bin/python" -e "$src[rag]"
echo "  + engram installed (editable, [rag]) into $venv"

# Register the 'engram' Jupyter kernel the playbooks target (papermill resolves it
# from the notebook kernelspec; without it, digest/playbook.run fail with NoSuchKernel).
"$venv/bin/python" -m ipykernel install --name engram --display-name Engram --prefix "$venv" >/dev/null
echo "  + 'engram' Jupyter kernel registered"

# Initialize DB. The python entry points apply schema on first connect.
export ENGRAM_CONFIG="$root/config.yml"
echo "==> Initializing database (applies schema, creates vec0 table)"
"$venv/bin/python" -c "from engram.common.db import get_connection; c = get_connection(); c.close(); print('  ok')"

cat <<EOF

==> Done.

Next steps:
  1. Edit $root/config.yml if you want different paths.
  2. Edit $root/.env for the LLM provider (ENGRAM_LLM_BASE_URL/API_KEY/MODEL) + source tokens.
  3. Open $root/vault in Obsidian; install Dataview + Templater plugins.
  4. Wire the MCP server into Claude Code:
       claude mcp add -s user engram $venv/bin/engram-mcp
       claude mcp list   # verify ✓ Connected
  5. In separate shells (or via the systemd user units):
       ./bin/eos-projector
       ./bin/eos-watcher
       ./bin/eos-reactor
  6. Optional — ambient memory (auto-inject retrieval each turn): run the grounding
     daemon ('engram-rag serve') and enable the plugin (see engram-plugin/README.md).
EOF
