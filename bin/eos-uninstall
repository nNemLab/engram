#!/usr/bin/env bash
# Uninstall engram: optionally export the curated database, then remove the
# install — either the native runtime (root, systemd user units, MCP
# registration) or the Docker stack (compose project, engram-data volume, MCP
# registration), or both. The right mode is auto-detected; when both installs
# are present you are asked which to remove.
#
# The source checkout (the code) is intentionally left in place — this script
# lives inside it. Removal is gated behind a typed confirmation and cannot be
# bypassed; there is no --yes flag by design.
set -euo pipefail

root="${ENGRAM_ROOT:-$HOME/.engram}"
venv="${ENGRAM_VENV:-$root/.venv}"

# Refuse to operate on a dangerous root (misconfigured ENGRAM_ROOT). The teardown
# does `rm -rf "$root"`, so guard against /, $HOME, and empty.
case "$root" in
    "" | "/" | "$HOME" | "$HOME/")
        echo "error: refusing to uninstall with ENGRAM_ROOT='$root' (unsafe path)" >&2
        exit 2 ;;
esac
src="$(cd "$(dirname "$0")/.." && pwd)"
compose_file="$src/docker/compose.yml"
docker_image="engram:local"

usage() {
    cat <<EOF
eos uninstall — remove engram (with optional database export)

Auto-detects how engram is installed and removes it:

  native   the runtime root ($root), the engram systemd user units, and the
           Claude Code MCP registration
  docker   the compose project 'engram' (containers, network, engram-data
           volume) and the Claude Code MCP registration

When both a native and a Docker install are present, you are asked which to
remove. Either way, the curated database is offered for export first.

The source checkout at $src is NOT removed.

usage: eos uninstall [-h|--help] [--native|--docker]

Options:
  --native      remove only the native install (skip Docker detection)
  --docker      remove only the Docker install (skip native detection)

Environment:
  ENGRAM_ROOT    runtime root to remove           (default: ~/.engram)
  ENGRAM_VENV    venv to remove if set outside the root
  ENGRAM_VAULT   host vault dir bind-mounted into the Docker stack
                 (default: \$src/docker/vault)
EOF
}

# --- Flag parsing ------------------------------------------------------------
mode_flag=""        # "", native, or docker
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --native)  mode_flag="native"; shift ;;
        --docker)  mode_flag="docker"; shift ;;
        *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

# --- Resolve the native database path ----------------------------------------
# Honor a custom paths.db in config.yml; fall back to the documented default.
# Dependency-free parse: first `db:` key under the paths block, ~ / $HOME
# expanded. The venv is not consulted (it is about to be deleted).
resolve_db_path() {
    local cfg="$root/config.yml" line val
    if [[ -f "$cfg" ]]; then
        line="$(grep -E '^[[:space:]]+db:[[:space:]]*' "$cfg" | head -n1 || true)"
        if [[ -n "$line" ]]; then
            val="${line#*db:}"
            val="${val%%#*}"                       # strip inline comment
            val="$(echo "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^["'\'']//' -e 's/["'\'']$//')"
            case "$val" in
                "~")   val="$HOME" ;;
                "~/"*) val="$HOME/${val#\~/}" ;;
            esac
            [[ -n "$val" ]] && { printf '%s\n' "$val"; return; }
        fi
    fi
    printf '%s\n' "$root/db.sqlite"
}
db_path="$(resolve_db_path)"

# --- Detect the native install -----------------------------------------------
units=(engram-projector engram-watcher engram-reactor engram-poller \
       engram-daily-digest.timer engram-daily-digest.service)
unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

have_root=false;  [[ -e "$root" ]] && have_root=true
have_units=false; compgen -G "$unit_dir/engram-*" >/dev/null 2>&1 && have_units=true
have_mcp=false
if command -v claude >/dev/null 2>&1 && claude mcp list 2>/dev/null | grep -qiE '(^|[^[:alnum:]])engram([^[:alnum:]]|$)'; then
    have_mcp=true
fi
have_native=false
if $have_root || $have_units || $have_mcp; then have_native=true; fi

# --- Detect the Docker install -----------------------------------------------
# docker on PATH AND (the engram-data volume exists OR a compose project named
# 'engram' is known). NOTE: `docker compose -p engram ls` is unreliable — the
# -p flag is ignored by `ls`, which always lists every project and exits 0. We
# therefore filter by name and require a non-empty result.
have_docker_install=false
if command -v docker >/dev/null 2>&1; then
    if docker volume inspect engram-data >/dev/null 2>&1; then
        have_docker_install=true
    else
        ls_json="$(docker compose ls --filter name=engram --format json 2>/dev/null || true)"
        case "$ls_json" in
            ""|"[]") ;;                       # no engram project
            *engram*) have_docker_install=true ;;
        esac
    fi
fi

# --- Honor explicit mode flags (suppress the other detection) ----------------
case "$mode_flag" in
    native) have_docker_install=false ;;
    docker) have_native=false ;;
esac

if ! $have_native && ! $have_docker_install; then
    echo "engram does not appear to be installed (no native runtime at $root, no units, no MCP registration, no Docker stack)."
    exit 0
fi

# --- Choose which install(s) to remove ---------------------------------------
do_native=false
do_docker=false
if $have_native && $have_docker_install; then
    echo "==> Engram uninstall"
    echo "    Both a native and a Docker install were detected."
    echo
    read -r -p "Remove which? [native/docker/both] " which || which=""
    case "$which" in
        native) do_native=true ;;
        docker) do_docker=true ;;
        both)   do_native=true; do_docker=true ;;
        *) echo "Aborted. Nothing was removed."; exit 1 ;;
    esac
    echo
elif $have_native; then
    do_native=true
else
    do_docker=true
fi

# =============================================================================
# Native uninstall
# =============================================================================
uninstall_native() {
    echo "==> Engram native uninstall"
    echo "    root:  $root $($have_root && echo '(present)' || echo '(absent)')"
    echo "    units: $($have_units && echo 'present' || echo 'absent')"
    echo "    mcp:   $($have_mcp && echo 'registered' || echo 'absent')"
    echo

    # --- Offer to export the curated database --------------------------------
    local exported_to="" size ts out bytes
    if [[ -f "$db_path" ]]; then
        size="$(du -h "$db_path" | cut -f1)"
        echo "Curated database: $db_path ($size)"
        echo "This is your canonical knowledge — the vault and indexes rebuild from it."
        read -r -p "Export it to a tarball before removal? [Y/n] " ans || ans=""
        case "$ans" in
            [Nn]|[Nn][Oo])
                echo "  Skipping export." ;;
            *)
                ts="$(date +%Y%m%d-%H%M%S)"
                out="$PWD/engram-export-$ts.tar.gz"
                tar -czf "$out" -C "$(dirname "$db_path")" "$(basename "$db_path")"
                # Verify the archive is non-empty and actually contains the db.
                if [[ ! -s "$out" ]] || ! tar -tzf "$out" | grep -q "$(basename "$db_path")"; then
                    echo "error: export verification failed for $out — aborting, nothing removed." >&2
                    exit 1
                fi
                bytes="$(wc -c < "$out" | tr -d '[:space:]')"
                exported_to="$out"
                echo "  + Exported $bytes bytes to $out"
                ;;
        esac
        echo
    else
        echo "No database found at $db_path — nothing to export."
        echo
    fi

    # --- Final, irreversible confirmation ------------------------------------
    echo "The following will be PERMANENTLY removed:"
    $have_units && echo "  - systemd user units: ${units[*]}"
    $have_mcp   && echo "  - Claude Code MCP registration: engram"
    $have_root  && echo "  - runtime root (db, vault, venv, playbooks): $root"
    echo
    if [[ -n "$exported_to" ]]; then
        echo "Your database was exported to: $exported_to"
        echo "Everything else below is gone for good once you confirm."
    else
        echo "!! No export was taken. ALL curated knowledge will be lost PERMANENTLY."
        echo "!! This cannot be undone."
    fi
    echo
    read -r -p "Type 'DELETE' to permanently remove engram (anything else aborts): " confirm || confirm=""
    if [[ "$confirm" != "DELETE" ]]; then
        echo "Aborted. Nothing was removed."
        exit 1
    fi

    # --- Teardown ------------------------------------------------------------
    echo
    echo "==> Removing engram (native)"

    if $have_units && command -v systemctl >/dev/null 2>&1; then
        systemctl --user disable --now "${units[@]}" >/dev/null 2>&1 || true
        rm -f "$unit_dir"/engram-*.service "$unit_dir"/engram-*.timer
        systemctl --user daemon-reload >/dev/null 2>&1 || true
        echo "  - systemd user units removed"
    fi

    if $have_mcp && command -v claude >/dev/null 2>&1; then
        claude mcp remove engram -s user >/dev/null 2>&1 \
            || claude mcp remove engram >/dev/null 2>&1 || true
        echo "  - MCP registration removed"
    fi

    if $have_root; then
        rm -rf "$root"
        echo "  - runtime root removed: $root"
    fi
    # venv configured outside the root (rare) — clean it up too.
    if [[ "$venv" != "$root"/* && -e "$venv" ]]; then
        rm -rf "$venv"
        echo "  - venv removed: $venv"
    fi

    echo
    echo "==> engram runtime removed."
    if [[ -n "$exported_to" ]]; then
        echo "    Your export: $exported_to"
    fi
    echo "    The source checkout was left in place. Remove it with:"
    echo "      rm -rf $src"
}

# =============================================================================
# Docker uninstall
# =============================================================================
uninstall_docker() {
    echo "==> Engram Docker uninstall"
    echo "    compose project: engram"
    echo "    data volume:     engram-data"
    echo "    image:           $docker_image"
    echo

    # --- Report DB size from the volume --------------------------------------
    # The db lives at /data/db.sqlite inside the engram-data volume. Read its
    # size by running a throwaway container over the volume (works stack up or
    # down). Best-effort: if it fails we still offer the export.
    local size
    size="$(docker run --rm -v engram-data:/data "$docker_image" \
                sh -c 'du -h /data/db.sqlite 2>/dev/null | cut -f1' 2>/dev/null || true)"
    if [[ -n "$size" ]]; then
        echo "Curated database: engram-data:/data/db.sqlite ($size)"
    else
        echo "Curated database: engram-data:/data/db.sqlite (size unavailable)"
    fi
    echo "This is your canonical knowledge — the vault and indexes rebuild from it."

    # --- Offer to export the curated database --------------------------------
    local exported_to="" ts out bytes
    read -r -p "Export it to a tarball before removal? [Y/n] " ans || ans=""
    case "$ans" in
        [Nn]|[Nn][Oo])
            echo "  Skipping export." ;;
        *)
            ts="$(date +%Y%m%d-%H%M%S)"
            out="$PWD/engram-export-$ts.tar.gz"
            # Primary: tar db.sqlite straight out of the volume.
            docker run --rm -v engram-data:/data -v "$PWD":/out "$docker_image" \
                tar -czf "/out/$(basename "$out")" -C /data db.sqlite >/dev/null 2>&1 \
                || docker compose -p engram cp engram:/data/db.sqlite "$out" >/dev/null 2>&1 \
                || true
            # Verify the archive is non-empty and actually contains the db.
            if [[ ! -s "$out" ]] || ! tar -tzf "$out" 2>/dev/null | grep -q 'db.sqlite'; then
                echo "error: export verification failed for $out — aborting, nothing removed." >&2
                exit 1
            fi
            bytes="$(wc -c < "$out" | tr -d '[:space:]')"
            exported_to="$out"
            echo "  + Exported $bytes bytes to $out"
            ;;
    esac
    echo

    # --- Final, irreversible confirmation ------------------------------------
    echo "The following will be PERMANENTLY removed:"
    echo "  - Docker compose project 'engram' (containers + network)"
    echo "  - the engram-data volume (db, indexes, playbooks)"
    command -v claude >/dev/null 2>&1 && echo "  - Claude Code MCP registration: engram"
    echo
    if [[ -n "$exported_to" ]]; then
        echo "Your database was exported to: $exported_to"
        echo "Everything else below is gone for good once you confirm."
    else
        echo "!! No export was taken. ALL curated knowledge will be lost PERMANENTLY."
        echo "!! This cannot be undone."
    fi
    echo
    read -r -p "Type 'DELETE' to permanently remove engram (anything else aborts): " confirm || confirm=""
    if [[ "$confirm" != "DELETE" ]]; then
        echo "Aborted. Nothing was removed."
        exit 1
    fi

    # --- Teardown ------------------------------------------------------------
    echo
    echo "==> Removing engram (Docker)"

    docker compose -f "$compose_file" -p engram down -v >/dev/null 2>&1 \
        || docker compose -p engram down -v >/dev/null 2>&1 || true
    echo "  - containers, network, and engram-data volume removed"

    if command -v claude >/dev/null 2>&1; then
        claude mcp remove engram -s user >/dev/null 2>&1 \
            || claude mcp remove engram >/dev/null 2>&1 || true
        echo "  - MCP registration removed"
    fi

    # --- Offer: delete the host vault bind-mount dir (default keep) -----------
    local vault_host="${ENGRAM_VAULT:-$src/docker/vault}"
    if [[ -d "$vault_host" ]]; then
        local vsize; vsize="$(du -h "$vault_host" 2>/dev/null | cut -f1)"
        read -r -p "Also delete the host vault dir $vault_host ($vsize)? [y/N] " v || v=""
        case "$v" in
            [Yy]*) rm -rf "$vault_host"; echo "  - host vault removed: $vault_host" ;;
            *)     echo "  host vault kept: $vault_host" ;;
        esac
    fi

    # --- Offer: remove the image (default keep) ------------------------------
    read -r -p "Remove the engram Docker image ($docker_image)? [y/N] " im || im=""
    case "$im" in
        [Yy]*) docker image rm "$docker_image" >/dev/null 2>&1 || true; echo "  - image removed: $docker_image" ;;
        *)     echo "  image kept (docker image rm $docker_image to drop it)" ;;
    esac

    echo
    echo "==> engram Docker stack removed."
    if [[ -n "$exported_to" ]]; then
        echo "    Your export: $exported_to"
    fi
    echo "    The source checkout was left in place. Remove it with:"
    echo "      rm -rf $src"
}

# --- Run the chosen teardown(s) ----------------------------------------------
if $do_native; then
    uninstall_native
fi
if $do_docker; then
    $do_native && echo
    uninstall_docker
fi
